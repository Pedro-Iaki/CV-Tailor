ANTHROPIC_API_KEY=
CV_MODEL=claude-haiku-5-5
# Local model instead of the Anthropic API: any OpenAI-compatible server
# (Ollama, llama.cpp, LM Studio). CV_MODEL is then the model name on that server.
# CV_LLM_BASE_URL=http://localhost:11434/v1
# CV_MODEL=qwen3:8b
# CV_LLM_API_KEY=
# CV_LLM_TIMEOUT=600
# Reasoning effort for thinking models on a local server (low, medium, high).
# CV_LLM_REASONING=low
# Output-token cap per local call, thinking included (context window minus ~4.5k).
# CV_LLM_MAX_TOKENS=4096
# Careful mode: free-text analysis, selection, one review (or: apply.py new --careful).
# CV_LLM_MODE=careful
# Reasoning for careful mode's analysis/review passes; empty = the model's default.
# CV_LLM_CAREFUL_REASONING=default
# Ollama embedding model for "closest posting line" hints in careful mode.
# CV_LLM_EMBED_MODEL=bge-m3
ROUTE_THRESHOLD=0.6
CV_PDF_NAME={name}_CV_{role}_{LANG}
# Reasoning effort sent with each call (low keeps runs fast and cheap).
# Leave empty for models that do not support the effort parameter.
CV_EFFORT=low
# Opt-in: let the LLM draft wording for you to approve item by item
# (apply.py new --generate / generate <id>). Off by default.
CV_ALLOW_GENERATION=false
